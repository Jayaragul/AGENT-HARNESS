# LLM Backend: CODEX (OpenAI API key), CODEX_CLI (local Codex login), GEMINI, CLAUDE, OLLAMA, or MOCK
BACKEND=CODEX_CLI

# API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.1-codex
CODEX_CLI_COMMAND=codex
# Optional: leave blank to use the model selected by your local Codex CLI config.
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_SECONDS=180
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Optional path overrides. Defaults resolve from the repository, not the shell cwd.
# DATA_CATALOG_PATH=
# DATA_PATH=
# SKILLS_PATH=
# WIKI_PATH=
# OUTPUT_PATH=
# LOG_PATH=

# Logging
LOG_LEVEL=INFO
